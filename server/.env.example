PORT=4000
NODE_ENV=development

# SQL Server connection
DB_HOST=
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_CERT=true

CLIENT_ORIGIN=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

MAX_FILE_SIZE_MB=25

# Institutional mail relay (provided by ICT). No SMTP_USER/SMTP_PASSWORD for now —
# leave both blank unless ICT confirms the relay requires authentication; if it
# ever does, set them here and the transporter will pick them up automatically.
SMTP_HOST=mail.ea.aku.edu
SMTP_PORT=25
SMTP_SECURE=false
SMTP_IGNORE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=akuhtn.info@aku.edu
EMAIL_TO=
